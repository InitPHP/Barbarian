declare(strict_types=1);

use InitPHP\Barbarian\Console\CreateCommand;
use InitPHP\Barbarian\Console\DownCommand;
use InitPHP\Barbarian\Console\InitCommand;
use InitPHP\Barbarian\Console\StatusCommand;
use InitPHP\Barbarian\Console\UpCommand;
use InitPHP\Console\Application;

(static function (): void {
    $candidates = [
        $GLOBALS['_composer_autoload_path'] ?? null,
        __DIR__ . '/vendor/autoload.php',
        __DIR__ . '/../../autoload.php',
        __DIR__ . '/../vendor/autoload.php',
    ];
    foreach ($candidates as $file) {
        if (is_string($file) && is_file($file)) {
            require $file;

            return;
        }
    }
    fwrite(STDERR, 'Composer autoload file not found. Run "composer install" first.' . PHP_EOL);
    exit(1);
})();

$application = new Application('Barbarian', '2.0.0');
$application->register(InitCommand::class);
$application->register(CreateCommand::class);
$application->register(StatusCommand::class);
$application->register(UpCommand::class);
$application->register(DownCommand::class);
$application->run();
